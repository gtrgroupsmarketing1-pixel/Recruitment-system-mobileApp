{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recruitment-system-ochre.vercel.app"
      }
    },
    "production": {
      "node": "22.14.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recruitment-system-ochre.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
